# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database
# LOCAL (pgAdmin / local PostgreSQL 18):
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/rms_dev
#
# NEON (staging) — copy the pooled connection string from the Neon dashboard.
# It must end with ?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/rms?sslmode=require

# The restaurant's IANA timezone. Every booking rule is evaluated against this,
# never against the browser clock. See proposal §12 edge case E-01.
RESTAURANT_TIMEZONE=Asia/Karachi

# Which origins may call the API. Comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
